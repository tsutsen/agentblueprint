{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "api.schema.json",
  "title": "ApiSpec",
  "description": "Interface specification for all functions exposed by a module. Source of truth for test spec and cross-spec linting.",
  "type": "object",
  "required": ["version", "module", "functions"],
  "additionalProperties": false,

  "definitions": {
    "typeRef": {
      "type": "string",
      "description": "A type name: primitive, entity name, enum name, or array thereof (e.g. 'string', 'User', 'OrderStatus', 'OrderItem[]'). Use 'void' for functions that return nothing."
    },
    "parameterObject": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "camelCase parameter name.",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "type": { "$ref": "#/definitions/typeRef" },
        "required": {
          "type": "boolean",
          "default": true
        },
        "description": { "type": "string" },
        "example": {}
      }
    },
    "errorCondition": {
      "type": "object",
      "required": ["code", "condition"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code, e.g. 'NOT_FOUND', 'UNAUTHORIZED'.",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "condition": {
          "type": "string",
          "description": "Human-readable description of when this error is thrown."
        },
        "returnType": {
          "type": "string",
          "description": "What the caller receives: exception class name, HTTP status, or error shape."
        }
      }
    }
  },

  "properties": {

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "module": {
      "type": "string",
      "description": "Must match the module name in the corresponding data spec.",
      "minLength": 1
    },

    "description": { "type": "string" },

    "dataSpecVersion": {
      "type": "string",
      "description": "Version of the data spec this API spec was authored against. Used for drift detection.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "functions": {
      "type": "array",
      "description": "All functions exposed by this module.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "inputs", "output"],
        "additionalProperties": false,
        "properties": {

          "id": {
            "type": "string",
            "description": "Stable unique identifier for this function, e.g. 'FN-placeOrder'. Used by data spec apiRef and test spec fnRef.",
            "pattern": "^FN-[a-z][A-Za-z0-9]*$"
          },

          "name": {
            "type": "string",
            "description": "camelCase function name as it appears in code.",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },

          "description": {
            "type": "string",
            "description": "One sentence: what this function does."
          },

          "entity": {
            "type": "string",
            "description": "Entity this function primarily operates on. Must match an entity name in the data spec.",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },

          "inputs": {
            "type": "array",
            "description": "Input parameters. May be empty for zero-argument functions.",
            "items": { "$ref": "#/definitions/parameterObject" }
          },

          "output": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "description": "Return value of the function.",
            "properties": {
              "type": { "$ref": "#/definitions/typeRef" },
              "description": { "type": "string" },
              "example": {}
            }
          },

          "errors": {
            "type": "array",
            "description": "All documented error conditions. Every error must be covered by a test.",
            "items": { "$ref": "#/definitions/errorCondition" }
          },

          "visibility": {
            "type": "string",
            "enum": ["public", "internal"],
            "default": "public"
          },

          "pure": {
            "type": "boolean",
            "description": "True if this function has no side effects (same input always yields same output). Informs test strategy.",
            "default": false
          },

          "tags": {
            "type": "array",
            "description": "Optional grouping tags, e.g. ['auth', 'admin'].",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
