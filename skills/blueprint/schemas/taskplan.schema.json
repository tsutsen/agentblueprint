{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "taskplan.schema.json",
  "title": "TaskPlan",
  "description": "Sequenced set of epics and milestones derived from GoalSpec, DesignSpec, and ArchitectureSpec. Version 1.0.0.",
  "type": "object",
  "required": [
    "version",
    "schemaVersion",
    "project",
    "milestones",
    "epics"
  ],
  "additionalProperties": false,
  "definitions": {
    "epicId": {
      "type": "string",
      "description": "Epic identifier, sequential and zero-padded.",
      "pattern": "^EP-\\d{3}$"
    },
    "milestoneId": {
      "type": "string",
      "description": "Milestone identifier, sequential.",
      "pattern": "^M\\d+$"
    },
    "epicStatus": {
      "type": "string",
      "description": "Lifecycle status of an epic.",
      "enum": [
        "not_started",
        "in_progress",
        "complete"
      ]
    },
    "glId": {
      "type": "string",
      "description": "Glossary term identifier, format GL-NNN-PascalCase.",
      "pattern": "^GL-\\d{3}-[A-Z][a-zA-Z0-9]*$"
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Semver version of this taskplan document instance.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "description": "Version of the TaskPlan schema this document conforms to. Must be '1.0.0'.",
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "description": "Project name. Must match GoalSpec.project.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Lifecycle status of this spec.",
      "enum": [
        "draft",
        "review",
        "confirmed",
        "superseded"
      ],
      "default": "draft"
    },
    "milestones": {
      "type": "array",
      "description": "Major checkpoints. Each must produce a demonstrable project outcome. Every epic listed here must also have this milestone as its 'milestone' field.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "outcome",
          "epics"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/milestoneId",
            "x_idPattern": "milestone"
          },
          "name": {
            "type": "string",
            "description": "Short, outcome-oriented name. Not a sprint number.",
            "minLength": 5
          },
          "outcome": {
            "type": "string",
            "description": "One sentence describing what can be demonstrated at this milestone.",
            "minLength": 10
          },
          "epics": {
            "type": "array",
            "description": "EP-NNN IDs that must be complete for this milestone.",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/epicId"
            }
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "description": "Sequenced set of epics. Each epic covers at least one requirement and has a file in tasks/epics/.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "milestone",
          "requirements",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/epicId",
            "x_idPattern": "ep"
          },
          "title": {
            "type": "string",
            "description": "Action-oriented title describing a capability, not a technical layer. Example: 'Implement document ingestion pipeline' not 'Write database migrations'.",
            "minLength": 5
          },
          "glossaryRefs": {
            "type": "array",
            "description": "Glossary term IDs (GL-NNN) that this epic's title and objective reference. Links domain concepts from the glossary to implementation planning.",
            "items": {
              "$ref": "#/definitions/glId"
            }
          },
          "status": {
            "$ref": "#/definitions/epicStatus",
            "description": "Lifecycle status of this epic.",
            "default": "not_started"
          },
          "milestone": {
            "$ref": "#/definitions/milestoneId",
            "description": "The milestone this epic belongs to."
          },
          "requirements": {
            "type": "array",
            "description": "REQ-IDs from GoalSpec covered by this epic. Must not be empty.",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{3}$"
            }
          },
          "summary": {
            "type": "string",
            "description": "One line describing what this epic delivers.",
            "minLength": 10
          },
          "objective": {
            "type": "string",
            "description": "What this epic delivers and why. Must answer what capability it produces and which requirements it addresses."
          },
          "scope": {
            "type": "object",
            "description": "Explicit boundary of this epic.",
            "additionalProperties": false,
            "properties": {
              "inScope": {
                "type": "array",
                "description": "Capabilities and behaviours included.",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "inScopeGlossaryRefs": {
                "type": "array",
                "description": "Glossary term IDs (GL-NNN) referenced in inScope items.",
                "items": {
                  "$ref": "#/definitions/glId"
                }
              },
              "outOfScope": {
                "type": "array",
                "description": "Related work intentionally deferred or excluded. Must be specific, not vague.",
                "items": {
                  "type": "string",
                  "minLength": 5
                },
                "minItems": 1
              },
              "outOfScopeGlossaryRefs": {
                "type": "array",
                "description": "Glossary term IDs (GL-NNN) referenced in outOfScope items.",
                "items": {
                  "$ref": "#/definitions/glId"
                }
              }
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "description": "Objective conditions that mark this epic complete. Each must be independently verifiable and binary (pass/fail) where possible. Describe observable behaviour, not implementation details.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "specDependencies": {
            "type": "object",
            "description": "Blocking relationships between epics.",
            "additionalProperties": false,
            "properties": {
              "blockedBy": {
                "type": "array",
                "description": "EP-NNN IDs that must complete before this one can start.",
                "items": {
                  "$ref": "#/definitions/epicId"
                }
              },
              "blocks": {
                "type": "array",
                "description": "EP-NNN IDs that cannot start until this one is complete.",
                "items": {
                  "$ref": "#/definitions/epicId"
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Open questions, risks, or context for whoever implements this epic."
          },
          "filePath": {
            "type": "string",
            "description": "Path to the epic markdown file relative to project root. Must match tasks/epics/EP-<NNN>/EP-<NNN>-<slug>.md.",
            "pattern": "^tasks/epics/EP-\\d{3}/.*\\.md$"
          },
          "designRefs": {
            "type": "array",
            "description": "DG-IDs and SCR-IDs from DesignSpec design goals and screens this epic implements.",
            "items": {
              "type": "string"
            }
          },
          "archRefs": {
            "type": "array",
            "description": "COMP-IDs and CON-IDs from ArchitectureSpec components and constraints this epic implements.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "goalSpecVersion": {
      "type": "string",
      "description": "Version of the GoalSpec this spec was reviewed against.",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    }
  },
  "outputFiles": [
    "tasks/PLAN.md",
    "tasks/epics/"
  ],
  "specDependencies": {
    "goalSpec": {
      "required": true
    },
    "designSpec": {
      "required": true
    },
    "architectureSpec": {
      "required": true
    },
    "dataSpec": {
      "required": true
    },
    "apiSpec": {
      "required": true
    },
    "testSpec": {
      "required": true
    }
  }
}