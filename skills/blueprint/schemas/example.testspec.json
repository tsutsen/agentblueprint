  "tests": [
    {
      "id": "TST-000-Authenticate-001",
      "fnRef": "ENDP-000-Authenticate",
      "category": "happy-path",
      "description": "Routes a simple query to the highest priority available backend.",
      "input": {
        "content": "What is 2+2?"
      },
      "expectedOutput": {
        "id": "qry_001",
        "status": "COMPLETED",
        "content": "What is 2+2?",
        "name": "qry_001"
      },
      "expectedOutputType": "Query",
      "contractClause": "Routes a query to the most appropriate backend based on classification and availability.",
      "reqRefs": [
        "REQ-001-Login"
      ],
      "name": "Authenticate",
      "glossaryRefs": [
        "GL-000-Backend",
        "GL-002-Query"
      ]
    },
    {
      "id": "TST-001-CreateUser-001",
      "fnRef": "ENDP-001-CreateUser",
      "category": "happy-path",
      "description": "Routes a query to a specific backend when overrideBackendId is provided.",
      "input": {
        "content": "Translate to French",
        "overrideBackendId": "bck_cloud_001"
      },
      "expectedOutput": {
        "id": "qry_002",
        "status": "COMPLETED",
        "overrideBackendId": "bck_cloud_001",
        "name": "qry_002"
      },
      "expectedOutputType": "Query",
      "contractClause": "Bypasses classification when overrideBackendId is provided.",
      "reqRefs": [
        "REQ-001-Login"
      ],
      "nfrRefs": [
        "NFR-002-Security"
      ],
      "name": "Create User",
      "glossaryRefs": [
        "GL-000-Backend",
        "GL-002-Query"
      ]
    },
