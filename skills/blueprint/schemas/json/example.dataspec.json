{
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "module": "LLMGateway",
  "description": "Data model for the LLM Gateway system — routes queries to appropriate LLM backends.",
  "primitives": ["string", "number", "boolean", "null", "any"],
  "enums": [
    {
      "name": "BackendType",
      "description": "Type of LLM backend.",
      "values": [
        { "name": "LOCAL", "description": "Local LLM running on-premise." },
        { "name": "CLOUD", "description": "Cloud-hosted LLM API." }
      ]
    },
    {
      "name": "QueryStatus",
      "description": "Status of a query lifecycle.",
      "values": [
        { "name": "PENDING" },
        { "name": "ROUTED" },
        { "name": "COMPLETED" },
        { "name": "FAILED" }
      ]
    }
  ],
  "entities": [
    {
      "name": "User",
      "description": "A developer who submits queries to the gateway.",
      "fields": [
        { "name": "id", "type": "string", "required": true, "description": "Unique identifier.", "example": "usr_abc123" },
        { "name": "email", "type": "string", "required": true, "description": "User's email address.", "example": "dev@example.com" },
        { "name": "createdAt", "type": "string", "required": true, "description": "ISO 8601 timestamp of account creation.", "example": "2025-01-01T00:00:00Z" }
      ],
      "methods": [
        { "name": "getHistory", "apiRef": "FN-getUserHistory", "description": "Retrieve past queries." }
      ],
      "visibility": "public"
    },
    {
      "name": "Backend",
      "description": "An LLM backend (local or cloud) available for routing.",
      "fields": [
        { "name": "id", "type": "string", "required": true, "description": "Unique backend identifier.", "example": "bck_xyz789" },
        { "name": "name", "type": "string", "required": true, "description": "Human-readable name.", "example": "Ollama Local" },
        { "name": "type", "type": "BackendType", "required": true, "description": "Whether local or cloud.", "example": "LOCAL" },
        { "name": "url", "type": "string", "required": false, "description": "API endpoint URL.", "example": "http://localhost:11434" },
        { "name": "isActive", "type": "boolean", "required": true, "description": "Whether this backend is available.", "example": true }
      ],
      "visibility": "public"
    },
    {
      "name": "Query",
      "description": "A single query submitted by a user.",
      "fields": [
        { "name": "id", "type": "string", "required": true, "description": "Unique query identifier.", "example": "qry_def456" },
        { "name": "userId", "type": "string", "required": true, "description": "Reference to the user who submitted it.", "example": "usr_abc123" },
        { "name": "content", "type": "string", "required": true, "description": "The query text.", "example": "Translate this to French" },
        { "name": "status", "type": "QueryStatus", "required": true, "description": "Current lifecycle status.", "example": "COMPLETED" },
        { "name": "latencyMs", "type": "number", "required": false, "description": "Response latency in milliseconds.", "example": 250 },
        { "name": "createdAt", "type": "string", "required": true, "description": "ISO 8601 timestamp.", "example": "2025-06-15T10:30:00Z" }
      ],
      "methods": [
        { "name": "route", "apiRef": "FN-routeQuery", "description": "Route this query to a backend." },
        { "name": "cancel", "apiRef": "FN-cancelQuery", "description": "Cancel an in-flight query." }
      ],
      "visibility": "public"
    },
    {
      "name": "QueryLog",
      "description": "A log entry recording a query and its routing outcome.",
      "extends": "Query",
      "fields": [
        { "name": "backendId", "type": "string", "required": true, "description": "Which backend handled this query.", "example": "bck_xyz789" },
        { "name": "response", "type": "string", "required": false, "description": "The LLM response text.", "example": "Voici la traduction..." }
      ],
      "visibility": "public"
    }
  ],
  "relationships": [
    {
      "from": "User",
      "to": "Query",
      "type": "composition",
      "cardinality": { "fromLabel": "1", "toLabel": "1..*" },
      "label": "submits",
      "description": "A user composes queries; deleting the user removes their queries."
    },
    {
      "from": "Query",
      "to": "Backend",
      "type": "association",
      "cardinality": { "fromLabel": "1", "toLabel": "1" },
      "label": "routed to",
      "description": "Each query is routed to exactly one backend."
    },
    {
      "from": "QueryLog",
      "to": "Backend",
      "type": "association",
      "cardinality": { "fromLabel": "1", "toLabel": "1" },
      "label": "handled by",
      "description": "A query log entry records which backend handled the query."
    }
  ]
}
