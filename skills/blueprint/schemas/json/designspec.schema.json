{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "designspec.schema.json",
  "title": "DesignSpec",
  "description": "User experience, interaction model, and visual design requirements. Contract between product requirements and implementation. Version 4.0.0.",
  "type": "object",
  "required": [
    "version",
    "schemaVersion",
    "project",
    "goalSpecVersion",
    "status",
    "designGoals",
    "personas",
    "userJourneys",
    "informationArchitecture",
    "screenInventory",
    "screenSpecs",
    "interactionPatterns",
    "visualDesignRequirements",
    "designSystem",
    "accessibilityRequirements",
    "uxAcceptanceCriteria"
  ],
  "additionalProperties": false,
  "definitions": {
    "screenId": {
      "type": "string",
      "description": "kebab-case screen identifier, e.g. 'library-screen', 'search-panel'.",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "patternId": {
      "type": "string",
      "description": "kebab-case interaction pattern identifier, e.g. 'keyboard-navigation'.",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "personaId": {
      "type": "string",
      "description": "kebab-case persona identifier, e.g. 'power-developer'.",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reqId": {
      "type": "string",
      "pattern": "^REQ-\\d{3}$"
    },
    "usId": {
      "type": "string",
      "pattern": "^US-\\d{3}$"
    },
    "fnId": {
      "type": "string",
      "description": "Function ID from ApiSpec. Format: FN-camelCase, e.g. 'FN-createUser'.",
      "pattern": "^FN-[a-z][A-Za-z0-9]*$"
    },
    "uxacId": {
      "type": "string",
      "pattern": "^UXAC-\\d{3}$"
    },
    "vdrId": {
      "type": "string",
      "pattern": "^VDR-\\d{3}$"
    },
    "arId": {
      "type": "string",
      "pattern": "^AR-\\d{3}$"
    },
    "namedRequirement": {
      "type": "object",
      "description": "A verifiable design requirement with a stable ID.",
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Short descriptive name summarizing this requirement.",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "The requirement in plain language. Must be verifiable \u2014 avoid subjective terms.",
          "minLength": 10
        },
        "rationale": {
          "type": "string"
        },
        "reqRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reqId"
          }
        }
      }
    },
    "iaNode": {
      "type": "object",
      "description": "A node in the information architecture tree.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Label as it appears in navigation.",
          "minLength": 1
        },
        "screenRef": {
          "$ref": "#/definitions/screenId",
          "description": "Screen ID this node navigates to. Required for leaf nodes."
        },
        "children": {
          "type": "array",
          "description": "Child nodes. If present, this is a grouping node \u2014 screenRef should be omitted.",
          "items": {
            "$ref": "#/definitions/iaNode"
          }
        }
      }
    },
    "glId": {
      "type": "string",
      "description": "Glossary term identifier (GL-NNN).",
      "pattern": "^GL-\\d{3}$"
    },
    "dgId": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d{3}-[a-z][a-z0-9-]*$",
      "description": "Unique identifier for dg"
    },
    "spcId": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d{3}-[a-z][a-z0-9-]*$",
      "description": "Unique identifier for spc"
    },
    "patId": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d{3}-[a-z][a-z0-9-]*$",
      "description": "Unique identifier for pat"
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Semver version of this designspec document instance.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "description": "Version of the DesignSpec schema this document conforms to. Must be '4.0.0'.",
      "const": "4.0.0"
    },
    "project": {
      "type": "string",
      "description": "Must match the project name in the corresponding GoalSpec.",
      "minLength": 1
    },
    "goalSpecVersion": {
      "type": "string",
      "description": "Version of the GoalSpec this design was produced against.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "confirmed",
        "superseded"
      ],
      "default": "draft"
    },
    "designGoals": {
      "type": "array",
      "description": "High-level UX objectives. Each must describe a desired user experience quality, not an implementation approach.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DG-\\d{3}$"
          },
          "goal": {
            "type": "string",
            "description": "A UX quality the design must achieve.",
            "minLength": 5
          },
          "name": {
            "type": "string",
            "description": "Short descriptive name summarizing this design goal."
          },
          "description": {
            "type": "string",
            "description": "Longer description of this design goal and how it will be achieved."
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "description": "Descriptions of target users. Persona roles must be consistent with actors in the GoalSpec.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "goals",
          "painPoints",
          "technicalSkillLevel"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/personaId"
          },
          "name": {
            "type": "string",
            "description": "Human name for the persona, e.g. 'Leon'.",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "A brief description of this persona's role, context, and motivations."
          },
          "role": {
            "type": "string",
            "description": "The actor role this persona represents. Should match an actor named in GoalSpec.",
            "minLength": 1
          },
          "goals": {
            "type": "array",
            "description": "What this persona is trying to accomplish.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "painPoints": {
            "type": "array",
            "description": "Current frustrations this system addresses.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "technicalSkillLevel": {
            "type": "string",
            "description": "The persona's technical ability level.",
            "enum": [
              "non-technical",
              "basic",
              "intermediate",
              "advanced",
              "expert"
            ]
          },
          "notes": {
            "type": "string"
          },
          "glossaryRefs": {
            "type": "array",
            "description": "Glossary term IDs (GL-NNN) that this persona's role maps to. Use for cross-spec traceability with actors in GoalSpec.",
            "items": {
              "$ref": "#/definitions/glId"
            }
          }
        }
      }
    },
    "userJourneys": {
      "type": "array",
      "description": "End-to-end workflows from the user's perspective. Each must reference a GoalSpec user story.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "personaRef",
          "usRefs",
          "startingState",
          "steps",
          "desiredOutcome"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UJ-\\d{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "A brief description of this user journey. May restate startingState and desiredOutcome in one sentence."
          },
          "personaRef": {
            "$ref": "#/definitions/personaId",
            "description": "The persona this journey belongs to."
          },
          "usRefs": {
            "type": "array",
            "description": "US-IDs from GoalSpec this journey implements. Must not be empty.",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/usId"
            }
          },
          "reqRefs": {
            "type": "array",
            "description": "REQ-IDs from GoalSpec that this journey exercises end-to-end. Use for UJ\u2192REQ traceability. At least one must be present.",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/reqId"
            }
          },
          "fnRefs": {
            "type": "array",
            "description": "FN-IDs from ApiSpec that this journey exercises. Populated during implementation planning. Use for UJ\u2192FN traceability.",
            "items": {
              "$ref": "#/definitions/fnId"
            }
          },
          "startingState": {
            "type": "string",
            "description": "What the user and system state are at the beginning of this journey.",
            "minLength": 5
          },
          "steps": {
            "type": "array",
            "description": "Ordered steps alternating user actions and system responses.",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "actor",
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "actor": {
                  "type": "string",
                  "description": "Who performs this step.",
                  "enum": [
                    "user",
                    "system"
                  ]
                },
                "action": {
                  "type": "string",
                  "description": "What they do or what happens.",
                  "minLength": 3
                },
                "screenRef": {
                  "$ref": "#/definitions/screenId",
                  "description": "Screen the user is on during this step, if applicable."
                },
                "glossaryRefs": {
                  "type": "array",
                  "description": "Glossary term IDs (GL-NNN) referenced in this step's action description.",
                  "items": {
                    "$ref": "#/definitions/glId"
                  }
                }
              }
            }
          },
          "desiredOutcome": {
            "type": "string",
            "description": "The end state the user has reached when the journey succeeds.",
            "minLength": 5
          },
          "glossaryRefs": {
            "type": "array",
            "description": "Glossary term IDs (GL-NNN) referenced in this journey.",
            "items": {
              "$ref": "#/definitions/glId"
            }
          }
        }
      }
    },
    "informationArchitecture": {
      "type": "object",
      "description": "Navigation structure of the application. Leaf nodes must reference screen IDs.",
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "array",
          "description": "Top-level navigation nodes.",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/iaNode"
          }
        },
        "notes": {
          "type": "string"
        },
        "glossaryRefs": {
          "type": "array",
          "description": "Glossary term IDs (GL-NNN) referenced in the information architecture.",
          "items": {
            "$ref": "#/definitions/glId"
          }
        }
      }
    },
    "screenInventory": {
      "type": "array",
      "description": "All screens and views in the system. Screen IDs are the shared key referenced throughout the spec.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "primaryActions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/screenId"
          },
          "name": {
            "type": "string",
            "description": "Human-readable screen name.",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Longer description of the screen's purpose and behavior. If omitted, 'purpose' is used as fallback."
          },
          "purpose": {
            "type": "string",
            "description": "One sentence: what the user accomplishes on this screen.",
            "minLength": 10
          },
          "primaryActions": {
            "type": "array",
            "description": "The main things a user can do on this screen.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "inputs": {
            "type": "array",
            "description": "Data or content the user provides on this screen.",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "description": "Data or content the screen produces or displays.",
            "items": {
              "type": "string"
            }
          },
          "usRefs": {
            "type": "array",
            "description": "US-IDs this screen helps fulfil.",
            "items": {
              "$ref": "#/definitions/usId"
            }
          },
          "fnRefs": {
            "type": "array",
            "description": "FN-IDs from ApiSpec that this screen's interactions exercise. Populated during implementation planning. Use for SCR\u2192FN traceability.",
            "items": {
              "$ref": "#/definitions/fnId"
            }
          },
          "glossaryRefs": {
            "type": "array",
            "description": "Glossary term IDs (GL-NNN) referenced in the screen's purpose description.",
            "items": {
              "$ref": "#/definitions/glId"
            }
          }
        }
      }
    },
    "screenSpecs": {
      "type": "array",
      "description": "Detailed specifications for each screen. Must cover every screen in the inventory.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "screenRef",
          "layout",
          "components",
          "states",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "screenRef": {
            "$ref": "#/definitions/screenId",
            "description": "Must match a screen ID in the screen inventory."
          },
          "layout": {
            "type": "string",
            "description": "Description of the spatial arrangement of elements on this screen.",
            "minLength": 10
          },
          "wireframe": {
            "type": "string",
            "description": "ASCII sketch or description of the low-fidelity layout. Not intended to define final visuals."
          },
          "components": {
            "type": "array",
            "description": "UI components present on this screen.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "purpose"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Component name, e.g. 'Query field', 'Results list'.",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "description": "What this component does for the user.",
                  "minLength": 5
                },
                "designSystemRef": {
                  "type": "string",
                  "description": "Name of the design system component this maps to, if applicable."
                },
                "patternRefs": {
                  "type": "array",
                  "description": "Interaction pattern IDs that apply to this component.",
                  "items": {
                    "$ref": "#/definitions/patternId"
                  }
                },
                "glossaryRefs": {
                  "type": "array",
                  "description": "Glossary term IDs (GL-NNN) referenced in this component's purpose description.",
                  "items": {
                    "$ref": "#/definitions/glId"
                  }
                }
              }
            }
          },
          "states": {
            "type": "array",
            "description": "All distinct visual/interaction states this screen can be in.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "State name, e.g. 'empty', 'loading', 'error', 'results'.",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "description": "What the screen looks like and how it behaves in this state.",
                  "minLength": 5
                }
              }
            }
          },
          "interactions": {
            "type": "array",
            "description": "User interactions available on this screen.",
            "items": {
              "type": "object",
              "required": [
                "trigger",
                "response"
              ],
              "additionalProperties": false,
              "properties": {
                "trigger": {
                  "type": "string",
                  "description": "What the user does, e.g. 'Presses Enter in query field'.",
                  "minLength": 3
                },
                "response": {
                  "type": "string",
                  "description": "What the system does in response.",
                  "minLength": 3
                },
                "patternRef": {
                  "$ref": "#/definitions/patternId",
                  "description": "Interaction pattern this follows, if applicable."
                }
              }
            }
          },
          "glossaryRefs": {
            "type": "array",
            "description": "Glossary term IDs (GL-NNN) referenced in this screen spec.",
            "items": {
              "$ref": "#/definitions/glId"
            }
          },
          "id": {
            "type": "string",
            "description": "Unique identifier for this screen spec"
          }
        }
      }
    },
    "interactionPatterns": {
      "type": "array",
      "description": "Reusable interaction rules defined once and referenced throughout screen specs.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/patternId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "How this pattern behaves from the user's perspective.",
            "minLength": 10
          },
          "examples": {
            "type": "array",
            "description": "Concrete instances of this pattern in the UI.",
            "items": {
              "type": "string"
            }
          },
          "keyboardShortcuts": {
            "type": "array",
            "description": "Keyboard shortcuts associated with this pattern.",
            "items": {
              "type": "object",
              "required": [
                "keys",
                "action"
              ],
              "additionalProperties": false,
              "properties": {
                "keys": {
                  "type": "string",
                  "description": "Key combination, e.g. 'Ctrl+K', 'Escape'."
                },
                "action": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "visualDesignRequirements": {
      "type": "array",
      "description": "Appearance constraints. Must describe requirements, not artistic preferences.",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/namedRequirement"
          },
          {
            "properties": {
              "id": {
                "pattern": "^VDR-\\d{3}$"
              }
            }
          }
        ]
      }
    },
    "designSystem": {
      "type": "object",
      "description": "Reusable UI building blocks that define consistency across the product.",
      "required": [
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "baseStyle": {
          "type": "string",
          "description": "The visual style foundation, e.g. 'Adwaita', 'Material', 'custom'."
        },
        "components": {
          "type": "array",
          "description": "Named reusable UI components.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "purpose"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Component name, e.g. 'Button', 'Card', 'Dialog'.",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "description": "What this component communicates or enables.",
                "minLength": 5
              },
              "variants": {
                "type": "array",
                "description": "Named variants of this component, e.g. 'primary', 'destructive', 'ghost'.",
                "items": {
                  "type": "string"
                }
              },
              "usageNotes": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "accessibilityRequirements": {
      "type": "array",
      "description": "Accessibility expectations. Each must be independently verifiable.",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/namedRequirement"
          },
          {
            "properties": {
              "id": {
                "pattern": "^AR-\\d{3}$"
              }
            }
          }
        ]
      }
    },
    "uxAcceptanceCriteria": {
      "type": "array",
      "description": "Design-specific success criteria. Each must be binary, verifiable, and linked to a GoalSpec story or requirement.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/uxacId"
          },
          "name": {
            "type": "string",
            "description": "Short descriptive name summarizing this UX acceptance criterion (e.g. 'New Research Session').",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "A binary pass/fail UX condition. Must not be subjective.",
            "minLength": 10
          },
          "refs": {
            "type": "object",
            "description": "At least one US-ID or REQ-ID must be provided.",
            "additionalProperties": false,
            "properties": {
              "usRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/usId"
                }
              },
              "reqRefs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/reqId"
                }
              }
            }
          },
          "verificationMethod": {
            "type": "string",
            "description": "How this criterion will be verified, e.g. 'manual walkthrough', 'automated UI test'."
          }
        }
      }
    }
  }
}