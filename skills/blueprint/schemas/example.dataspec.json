{
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "module": "LLMGateway",
  "description": "Data entities for the LLM Gateway \u2014 manages queries, backends, and log entries.",
  "primitives": [
    "string",
    "number",
    "boolean",
    "null"
  ],
  "enums": [
    {
      "name": "QueryStatus",
      "values": [
        {
          "name": "PENDING",
          "description": "Query has been submitted but not yet routed."
        },
        {
          "name": "ROUTED",
          "description": "Query has been assigned to a backend."
        },
        {
          "name": "COMPLETED",
          "description": "Query has finished processing."
        },
        {
          "name": "FAILED",
          "description": "Query processing failed."
        }
      ]
    },
    {
      "name": "BackendStatus",
      "values": [
        {
          "name": "AVAILABLE",
          "description": "Backend is accepting new queries."
        },
        {
          "name": "UNAVAILABLE",
          "description": "Backend is not accepting new queries."
        }
      ]
    },
    {
      "name": "LogSeverity",
      "values": [
        {
          "name": "INFO",
          "description": "Informational log entry."
        },
        {
          "name": "WARN",
          "description": "Warning log entry."
        },
        {
          "name": "ERROR",
          "description": "Error log entry."
        }
      ]
    }
  ],
  "entities": [
    {
      "name": "Query",
      "description": "A query submitted for processing by the LLM Gateway.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "primaryKey": true,
          "description": "Unique identifier for the query.",
          "example": "qry_def456"
        },
        {
          "name": "content",
          "type": "string",
          "required": true,
          "description": "The query text submitted by the user.",
          "example": "Translate this to French"
        },
        {
          "name": "status",
          "type": "QueryStatus",
          "required": true,
          "description": "Current processing status of the query.",
          "example": "ROUTED"
        },
        {
          "name": "assignedBackendId",
          "type": "string",
          "required": false,
          "description": "ID of the backend this query is assigned to.",
          "example": "bck_xyz789"
        },
        {
          "name": "createdAt",
          "type": "string",
          "required": true,
          "description": "ISO 8601 timestamp when the query was created.",
          "example": "2024-01-15T10:30:00Z"
        },
        {
          "name": "completedAt",
          "type": "string",
          "required": false,
          "description": "ISO 8601 timestamp when the query completed or failed."
        }
      ],
      "methods": [
        {
          "name": "cancel",
          "apiRef": "FN-cancelQuery",
          "description": "Cancels an in-flight query."
        },
        {
          "name": "getHistory",
          "apiRef": "FN-getQueryHistory",
          "description": "Retrieves past query log entries."
        },
        {
          "name": "get",
          "apiRef": "FN-getQuery",
          "description": "Fetches a query by ID."
        }
      ]
    },
    {
      "name": "Backend",
      "description": "An LLM provider or service endpoint that processes queries.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "primaryKey": true,
          "description": "Unique identifier for the backend.",
          "example": "bck_xyz789"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Human-readable name of the backend.",
          "example": "OpenAI GPT-4"
        },
        {
          "name": "status",
          "type": "BackendStatus",
          "required": true,
          "description": "Current availability status.",
          "example": "AVAILABLE"
        },
        {
          "name": "priority",
          "type": "number",
          "required": true,
          "description": "Routing priority (lower number = higher priority).",
          "example": 1
        },
        {
          "name": "config",
          "type": "string",
          "required": false,
          "description": "Configuration details for connecting to this backend."
        }
      ],
      "methods": [
        {
          "name": "get",
          "apiRef": "FN-getBackend",
          "description": "Fetches a backend by ID."
        },
        {
          "name": "list",
          "apiRef": "FN-listBackends",
          "description": "Lists all configured backends."
        }
      ]
    },
    {
      "name": "LogEntry",
      "description": "A log entry recording a query processing event.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "primaryKey": true,
          "description": "Unique identifier for the log entry.",
          "example": "log_abc123"
        },
        {
          "name": "queryId",
          "type": "string",
          "required": true,
          "description": "ID of the associated query.",
          "example": "qry_def456"
        },
        {
          "name": "backendId",
          "type": "string",
          "required": false,
          "description": "ID of the backend involved in this event.",
          "example": "bck_xyz789"
        },
        {
          "name": "severity",
          "type": "LogSeverity",
          "required": true,
          "description": "Severity level of the log entry.",
          "example": "INFO"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "Human-readable log message.",
          "example": "Query routed to backend"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "ISO 8601 timestamp of the event.",
          "example": "2024-01-15T10:30:01Z"
        }
      ]
    }
  ],
  "relationships": [
    {
      "from": "Query",
      "to": "Backend",
      "type": "association",
      "cardinality": {
        "fromLabel": "0..1",
        "toLabel": "1"
      },
      "label": "routed to",
      "description": "A query is assigned to at most one backend during processing."
    },
    {
      "from": "LogEntry",
      "to": "Query",
      "type": "association",
      "cardinality": {
        "fromLabel": "1",
        "toLabel": "1"
      },
      "label": "records",
      "description": "Each log entry is associated with exactly one query."
    },
    {
      "from": "LogEntry",
      "to": "Backend",
      "type": "dependency",
      "cardinality": {
        "fromLabel": "0..1",
        "toLabel": "1"
      },
      "label": "involves",
      "description": "A log entry may reference a backend that handled the query."
    }
  ]
}
