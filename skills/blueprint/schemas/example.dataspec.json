{
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "enums": [
    {
      "name": "QueryStatus",
      "values": [
        {
          "name": "PENDING",
          "description": "Query has been submitted but not yet routed."
        },
        {
          "name": "ROUTED",
          "description": "Query has been assigned to a backend."
        },
        {
          "name": "COMPLETED",
          "description": "Query has finished processing."
        },
        {
          "name": "FAILED",
          "description": "Query processing failed."
        }
      ],
      "id": "NUM-000-QueryStatus",
      "description": "Enum for QueryStatus"
    },
    {
      "name": "BackendStatus",
      "values": [
        {
          "name": "AVAILABLE",
          "description": "Backend is accepting new queries."
        },
        {
          "name": "UNAVAILABLE",
          "description": "Backend is not accepting new queries."
        }
      ],
      "id": "NUM-001-BackendStatus",
      "description": "Enum for BackendStatus"
    },
    {
      "name": "LogSeverity",
      "values": [
        {
          "name": "INFO",
          "description": "Informational log entry."
        },
        {
          "name": "WARN",
          "description": "Warning log entry."
        },
        {
          "name": "ERROR",
          "description": "Error log entry."
        }
      ],
      "id": "NUM-002-LogSeverity",
      "description": "Enum for LogSeverity"
    }
  ],
  "entities": [
    {
      "name": "Query",
      "description": "A query submitted for processing by the LLM Gateway.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Unique identifier for the query.",
          "id": "FLD-000-id"
        },
        {
          "name": "content",
          "type": "string",
          "required": true,
          "description": "The query text submitted by the user.",
          "id": "FLD-000-content"
        },
        {
          "name": "status",
          "type": "QueryStatus",
          "required": true,
          "description": "Current processing status of the query.",
          "id": "FLD-000-status"
        },
        {
          "name": "assignedBackendId",
          "type": "string",
          "required": false,
          "description": "ID of the backend this query is assigned to.",
          "id": "FLD-000-assignedBackendId"
        },
        {
          "name": "createdAt",
          "type": "string",
          "required": true,
          "description": "ISO 8601 timestamp when the query was created.",
          "id": "FLD-000-createdAt"
        },
        {
          "name": "completedAt",
          "type": "string",
          "required": false,
          "description": "ISO 8601 timestamp when the query completed or failed.",
          "id": "FLD-000-completedAt"
        }
      ],
      "id": "ENT-000-Query",
      "functions": [
        {
          "name": "cancel",
          "apiRef": "ENDP-000-Authenticate",
          "description": "Cancels an in-flight query.",
          "id": "FUNC-000-Cancel"
        },
        {
          "name": "getHistory",
          "apiRef": "ENDP-001-CreateUser",
          "description": "Retrieves past query log entries.",
          "id": "FUNC-001-Gethistory"
        },
        {
          "name": "get",
          "apiRef": "ENDP-002-GetUser",
          "description": "Fetches a query by ID.",
          "id": "FUNC-002-Get"
        }
      ]
    },
    {
      "name": "Backend",
      "description": "An LLM provider or service endpoint that processes queries.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Unique identifier for the backend.",
          "id": "FLD-001-id"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "Human-readable name of the backend.",
          "id": "FLD-001-name"
        },
        {
          "name": "status",
          "type": "BackendStatus",
          "required": true,
          "description": "Current availability status.",
          "id": "FLD-001-status"
        },
        {
          "name": "priority",
          "type": "number",
          "required": true,
          "description": "Routing priority (lower number = higher priority).",
          "id": "FLD-001-priority"
        },
        {
          "name": "config",
          "type": "string",
          "required": false,
          "description": "Configuration details for connecting to this backend.",
          "id": "FLD-001-config"
        }
      ],
      "id": "ENT-001-Backend",
      "functions": [
        {
          "name": "get",
          "apiRef": "ENDP-003-ListUsers",
          "description": "Fetches a backend by ID.",
          "id": "FUNC-003-Get"
        },
        {
          "name": "list",
          "apiRef": "ENDP-004-UpdateUser",
          "description": "Lists all configured backends.",
          "id": "FUNC-004-List"
        }
      ]
    },
    {
      "name": "LogEntry",
      "description": "A log entry recording a query processing event.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "Unique identifier for the log entry.",
          "id": "FLD-002-id"
        },
        {
          "name": "queryId",
          "type": "string",
          "required": true,
          "description": "ID of the associated query.",
          "id": "FLD-002-queryId"
        },
        {
          "name": "backendId",
          "type": "string",
          "required": false,
          "description": "ID of the backend involved in this event.",
          "id": "FLD-002-backendId"
        },
        {
          "name": "severity",
          "type": "LogSeverity",
          "required": true,
          "description": "Severity level of the log entry.",
          "id": "FLD-002-severity"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "Human-readable log message.",
          "id": "FLD-002-message"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "ISO 8601 timestamp of the event.",
          "id": "FLD-002-timestamp"
        }
      ],
      "id": "ENT-002-LogEntry"
    }
  ],
  "relationships": [
    {
      "from": "ENT-000-Query",
      "to": "ENT-001-Backend",
      "type": "association",
      "cardinality": {
        "fromLabel": "0..1",
        "toLabel": "1"
      },
      "description": "A query is assigned to at most one backend during processing.",
      "id": "REL-000-Routedto",
      "name": "routed to"
    },
    {
      "from": "ENT-002-LogEntry",
      "to": "ENT-000-Query",
      "type": "association",
      "cardinality": {
        "fromLabel": "1",
        "toLabel": "1"
      },
      "description": "Each log entry is associated with exactly one query.",
      "id": "REL-001-Records",
      "name": "records"
    },
    {
      "from": "ENT-002-LogEntry",
      "to": "ENT-001-Backend",
      "type": "association",
      "cardinality": {
        "fromLabel": "0..1",
        "toLabel": "1"
      },
      "description": "A log entry may reference a backend that handled the query.",
      "id": "REL-002-Involves",
      "name": "involves"
    }
  ],
  "project": "LLMGateway"
}