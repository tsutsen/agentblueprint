{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "testspec.schema.json",
  "title": "TestSpec",
  "description": "Test specification for all API functions. Version 3.0.0.",
  "type": "object",
  "required": [
    "functionCoverage",
    "project",
    "schemaVersion",
    "tests",
    "version"
  ],
  "additionalProperties": false,
  "definitions": {
    "glId": {
      "type": "string",
      "description": "Glossary term identifier.",
      "x_idPattern": "gl"
    },
    "reqId": {
      "type": "string",
      "description": "Functional requirement identifier.",
      "x_idPattern": "req"
    },
    "nfrId": {
      "type": "string",
      "description": "Non-functional requirement identifier.",
      "x_idPattern": "nfr"
    },
    "scId": {
      "type": "string",
      "description": "Success criterion identifier.",
      "x_idPattern": "sc"
    },
    "usId": {
      "type": "string",
      "description": "User story identifier.",
      "x_idPattern": "us"
    },
    "ngId": {
      "type": "string",
      "description": "Non-goal identifier.",
      "x_idPattern": "ng"
    },
    "dgId": {
      "type": "string",
      "description": "Design goal identifier.",
      "x_idPattern": "dg"
    },
    "prsId": {
      "type": "string",
      "description": "Persona identifier.",
      "x_idPattern": "prs"
    },
    "ujId": {
      "type": "string",
      "description": "User journey identifier.",
      "x_idPattern": "uj"
    },
    "scrId": {
      "type": "string",
      "description": "Screen identifier.",
      "x_idPattern": "scr"
    },
    "spcId": {
      "type": "string",
      "description": "Screen spec identifier.",
      "x_idPattern": "spc"
    },
    "patId": {
      "type": "string",
      "description": "Interaction pattern identifier.",
      "x_idPattern": "pat"
    },
    "vdrId": {
      "type": "string",
      "description": "Visual design requirement identifier.",
      "x_idPattern": "vdr"
    },
    "uxacId": {
      "type": "string",
      "description": "UX acceptance criterion identifier.",
      "x_idPattern": "uxac"
    },
    "dtId": {
      "type": "string",
      "description": "Design token identifier.",
      "x_idPattern": "dt"
    },
    "arId": {
      "type": "string",
      "description": "Accessibility requirement identifier.",
      "x_idPattern": "ar"
    },
    "compId": {
      "type": "string",
      "description": "Component identifier.",
      "x_idPattern": "comp"
    },
    "conId": {
      "type": "string",
      "description": "Constraint identifier.",
      "x_idPattern": "con"
    },
    "flwId": {
      "type": "string",
      "description": "Data flow identifier.",
      "x_idPattern": "flw"
    },
    "entId": {
      "type": "string",
      "description": "Entity identifier.",
      "x_idPattern": "ent"
    },
    "numId": {
      "type": "string",
      "description": "Enum identifier.",
      "x_idPattern": "num"
    },
    "relId": {
      "type": "string",
      "description": "Relationship identifier.",
      "x_idPattern": "rel"
    },
    "fldId": {
      "type": "string",
      "description": "Entity field identifier.",
      "x_idPattern": "fld"
    },
    "funcId": {
      "type": "string",
      "description": "Function identifier.",
      "x_idPattern": "func"
    },
    "endpId": {
      "type": "string",
      "description": "Endpoint identifier.",
      "x_idPattern": "endp"
    },
    "tstId": {
      "type": "string",
      "description": "Test case identifier.",
      "x_idPattern": "tst"
    },
    "fcId": {
      "type": "string",
      "description": "Function coverage identifier.",
      "x_idPattern": "fc"
    },
    "epId": {
      "type": "string",
      "description": "Epic identifier.",
      "x_idPattern": "ep"
    },
    "isId": {
      "type": "string",
      "description": "Issue identifier.",
      "x_idPattern": "is"
    },
    "siId": {
      "type": "string",
      "description": "Sub-issue identifier.",
      "x_idPattern": "si"
    },
    "milId": {
      "type": "string",
      "description": "Milestone identifier.",
      "x_idPattern": "mil"
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Semver version of this spec document instance.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "type": "string",
      "description": "Project name. Must match across all specs.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Lifecycle status of this spec.",
      "enum": [
        "draft",
        "review",
        "confirmed",
        "superseded"
      ],
      "default": "draft"
    },
    "goalSpecVersion": {
      "type": "string",
      "description": "Version of the GoalSpec this spec was reviewed against.",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "description": "Version of the TestSpec schema this document conforms to. Must be '3.0.0'.",
      "const": "3.0.0"
    },
    "apiSpecVersion": {
      "type": "string",
      "description": "Version of the ApiSpec these tests cover."
    },
    "verificationStatus": {
      "type": "string",
      "default": "pending",
      "description": "Independent verification status."
    },
    "functionCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/fcId",
            "description": "Unique identifier for this fc.",
            "x_idPattern": "fc"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable fc name."
          },
          "description": {
            "type": "string",
            "description": "Longer description of this fc."
          },
          "fnRef": {
            "$ref": "#/definitions/endpId"
          },
          "happyPathCount": {
            "type": "integer",
            "minimum": 0
          },
          "edgeCaseCount": {
            "type": "integer",
            "minimum": 0
          },
          "errorPathCount": {
            "type": "integer",
            "minimum": 0
          },
          "outOfScope": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "glossaryRefs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/glId"
                  },
                  "description": "Glossary term IDs.",
                  "uniqueItems": true
                }
              },
              "required": [
                "description"
              ]
            }
          },
          "reqRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/reqId"
            },
            "description": "Functional requirement IDs."
          }
        },
        "required": [
          "description",
          "edgeCaseCount",
          "errorPathCount",
          "fnRef",
          "happyPathCount",
          "id",
          "name"
        ]
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/definitions/tstId",
            "description": "Unique identifier for this tst.",
            "x_idPattern": "tst"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable tst name."
          },
          "description": {
            "type": "string",
            "description": "Longer description of this tst."
          },
          "fnRef": {
            "$ref": "#/definitions/endpId"
          },
          "category": {
            "type": "string",
            "enum": [
              "happy-path",
              "edge-case",
              "error-path"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "properties": {},
            "required": [],
            "description": "Free-form input parameters for the test case."
          },
          "expectedOutput": {
            "description": "Any value."
          },
          "expectedOutputType": {
            "type": "string"
          },
          "contractClause": {
            "type": "string",
            "minLength": 5
          },
          "reqRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/reqId"
            },
            "description": "Functional requirement IDs."
          },
          "errorCode": {
            "type": "string"
          },
          "expectedError": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "returnType": {
                "type": "string"
              },
              "messageContains": {
                "type": "string"
              }
            },
            "required": []
          },
          "scRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/scId"
            },
            "description": "Success criterion IDs."
          },
          "nfrRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/nfrId"
            },
            "description": "Non-functional requirement IDs."
          },
          "entityRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/entId"
            },
            "description": "Entity IDs."
          },
          "constraintRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/conId"
            },
            "description": "Constraint IDs."
          },
          "usRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/usId"
            },
            "description": "User story IDs."
          },
          "ujRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ujId"
            },
            "description": "User journey IDs."
          },
          "screenRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/scrId"
            },
            "description": "Screen IDs."
          },
          "glossaryRefs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/glId"
            },
            "description": "Glossary term IDs.",
            "uniqueItems": true
          }
        },
        "required": [
          "category",
          "contractClause",
          "description",
          "fnRef",
          "id",
          "input",
          "name"
        ]
      }
    }
  }
}
